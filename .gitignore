# Secrets and local credentials: never commit environment files or key material.
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
secrets.*
credentials.*

# Local Python environments and generated bytecode.
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class

# Build artifacts, test caches, and local tool state.
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter runtime files; notebooks themselves remain trackable.
.ipynb_checkpoints/

# Operating-system metadata.
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Source data is local-only; do not stage the dataset directory or raw CSVs.
/DATASET/
*.csv
*.csv.gz

# Local logs.
*.log
